# Python 字节码和缓存
__pycache__/
*.py[cod]
*.pyc
*.pyd
*.pyo
*.cache
*.so

# 虚拟环境
venv/
env/
ENV/
.venv/
.env/

# 环境变量文件（避免泄露密钥）
.env
.env.local
.env.*.local

# 日志文件
logs/
*.log
*.pid

# 数据库文件
*.db
*.sqlite
*.sqlite3

# IDE 配置（如果不想上传 .idea）
.idea/
.vscode/
*.iml
.DS_Store

# 测试和临时文件
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 大型数据或模型文件
*.pkl
*.h5
*.ckpt
*.pt
*.pth
*.onnx
*.pb
*.tflite
data/
models/
*.zip
*.tar.gz
*.rar

# Docker 相关（运行时文件）
*.pid
docker-compose.override.yml

# 项目特定
app/service/ragflow/rag/res/*   # 你原来写的保留
*.pdf
*.docx
*.pptx